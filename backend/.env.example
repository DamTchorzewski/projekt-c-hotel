# Skopiuj ten plik jako .env i dostosuj wartości do swojego środowiska. (DamianTchorzewski_72206)

# Port, na którym nasłuchuje API. (DamianTchorzewski_72206)
PORT=3000
NODE_ENV=development

# Adres frontendu dopuszczony przez CORS (Vite domyślnie działa na porcie 5173). (DamianTchorzewski_72206)
FRONTEND_URL=http://localhost:5173

# Połączenie z bazą uruchamianą przez docker-compose.yml w katalogu głównym. (DamianTchorzewski_72206)
DATABASE_URL="postgresql://hotel_user:hotel_password@localhost:5432/hotel_c_db"

# Klucze systemów partnerów dla endpointów /external: nazwa:klucz, rozdzielone przecinkami. (DamianTchorzewski_72206)
# Każdy klucz ma od 16 do 128 znaków. Poniższa wartość służy tylko do pracy lokalnej, a produkcyjną wygeneruj osobno:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))" (DamianTchorzewski_72206)
INTEGRATION_API_KEYS=partner-d:dev-partner-d-key-0001

# Konto recepcji do pracy lokalnej: login "recepcja", hasło "hotel-dev". W produkcji ustaw własne wartości.
# Skrót innego hasła (w katalogu backend): node -e "console.log(require('bcryptjs').hashSync('haslo', 10))" (DamianTchorzewski_72206)
RECEPTION_LOGIN=recepcja
RECEPTION_PASSWORD_HASH='$2b$10$Gh2UvYozwSvb2D0tI4rjKuzlaHAjtNhTanWCZ3GNzYnEZDLCuokTO'
SESSION_SECRET=dev-only-session-secret-change-me-0001

# Limit żądań na adres IP (logowanie: 10 na minutę, /external: 60 na minutę, reszta: 120 na minutę). (DamianTchorzewski_72206)
# Ustaw false tylko lokalnie, gdy limit przeszkadza w ręcznych testach. (DamianTchorzewski_72206)
RATE_LIMIT_ENABLED=true
