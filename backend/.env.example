# Plik .env tworzy "npm run setup". Puste wartości dostają losowe klucze. (DamianTchorzewski_72206)
# Nowe klucze: npm run env:new, nowe hasło recepcji: npm run reception:password. (DamianTchorzewski_72206)

# Port, na którym nasłuchuje API. (DamianTchorzewski_72206)
PORT=3000
NODE_ENV=development

# Adres frontendu dopuszczony przez CORS (Vite domyślnie działa na porcie 5173). (DamianTchorzewski_72206)
FRONTEND_URL=http://localhost:5173

# Połączenie z bazą: postgresql://użytkownik:hasło@host:port/baza. (DamianTchorzewski_72206)
DATABASE_URL=

# Klucze systemów partnerów dla endpointów /external: nazwa:klucz, rozdzielone przecinkami, klucz 16-128 znaków. (DamianTchorzewski_72206)
INTEGRATION_API_KEYS=

# Konto recepcji. Hasło jest zapisane tylko jako skrót bcrypt. (DamianTchorzewski_72206)
RECEPTION_LOGIN=recepcja
RECEPTION_PASSWORD_HASH=

# Sekret podpisu sesji, co najmniej 32 znaki. (DamianTchorzewski_72206)
SESSION_SECRET=

# Partnerzy: true = atrapy (npm run mocks, npm start uruchamia je sam), false = prawdziwe systemy. (DamianTchorzewski_72206)
USE_PARTNER_MOCKS=true
PARTNER_MOCKS_URL=http://localhost:4000
PARTNER_A_URL=
PARTNER_A_API_KEY=
PARTNER_B_URL=
PARTNER_B_API_KEY=
PARTNER_D_URL=
PARTNER_D_API_KEY=

# Liczba zaufanych serwerów pośredniczących: lokalnie 0, za serwerem hostingu zwykle 1. (DamianTchorzewski_72206)
TRUST_PROXY_HOPS=0

# Limit żądań na adres IP (logowanie: 10 na minutę, /external: 60 na minutę, reszta: 120 na minutę). (DamianTchorzewski_72206)
# Ustaw false tylko lokalnie, gdy limit przeszkadza w ręcznych testach. (DamianTchorzewski_72206)
RATE_LIMIT_ENABLED=true
